# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Session pooler" / port 5432 URI for the loader script.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Anthropic API key for the Claude agent loop (not used by the data loader, but the
# backend app expects it). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
