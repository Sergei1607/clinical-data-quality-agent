# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database -------------------------------------------------------------------
# DATABASE_URL connects as the `postgres` owner role (full DDL). Used ONLY by
# scripts/load_data.py. Supabase: Project Settings -> Database -> Connection string
# -> URI (use the Session pooler / port 5432 URI). Replace [YOUR-PASSWORD] entirely,
# brackets included.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# AGENT_DATABASE_URL connects as `app_readonly` (SELECT-only on the four tables).
# This is what the agent's SQL tools use. Never let the app touch DATABASE_URL.
AGENT_DATABASE_URL=postgresql://app_readonly.your-project-ref:readonly-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- Claude API ----------------------------------------------------------------
# Not used by the data loader; the backend agent loop needs it.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Local dev default is the Vite
# server; in production set this to the deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173
